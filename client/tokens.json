      "muted": { "$value": "{primitive.color.stone.500}", "$type": "color" },
      "placeholder": { "$value": "{primitive.color.stone.400}", "$type": "color" },
      "border": { "$value": "{primitive.color.stone.200}", "$type": "color" },

      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.9rem", "$type": "dimension" }
    },
    "fontFamily": {
      "ui": { "$value": "'Inter', 'Segoe UI', system-ui, -apple-system, Roboto, Arial, sans-serif", "$type": "fontFamily" },
      "serif": { "$value": "'Source Serif 4', Georgia, 'Times New Roman', serif", "$type": "fontFamily" }
    },
    "radius": {
      "sm": { "$value": "8px", "$type": "dimension" },

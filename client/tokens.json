      "scrim": { "$value": "rgba(0, 0, 0, 0.45)", "$type": "color" },
      "scrim-strong": { "$value": "rgba(0, 0, 0, 0.82)", "$type": "color" },
      "thumb-remove-bg": { "$value": "rgba(0, 0, 0, 0.55)", "$type": "color" },
      "overlay-fg": { "$value": "#FFFFFF", "$type": "color" },
      "overlay-border": { "$value": "rgba(255, 255, 255, 0.25)", "$type": "color" },
      "overlay-btn": { "$value": "rgba(255, 255, 255, 0.1)", "$type": "color" },
      "overlay-btn-hover": { "$value": "rgba(255, 255, 255, 0.22)", "$type": "color" },
      "overlay-count": { "$value": "rgba(255, 255, 255, 0.14)", "$type": "color" },
      "overlay-count-border": { "$value": "rgba(255, 255, 255, 0.2)", "$type": "color" }
    },
    "font": {
      "ui": { "$value": "{primitive.fontFamily.ui}", "$type": "fontFamily" },
      "serif": { "$value": "{primitive.fontFamily.serif}", "$type": "fontFamily" }
    },
    "radius": {
      "sm": { "$value": "{primitive.radius.sm}", "$type": "dimension" },
      "default": { "$value": "{primitive.radius.default}", "$type": "dimension" },
      "full": { "$value": "{primitive.radius.full}", "$type": "dimension" }
    },
    "duration": {
      "fast": { "$value": "{primitive.duration.fast}", "$type": "duration" }
    },
    "shadow": {
      "modal": { "$value": "0 24px 60px rgba(0, 0, 0, 0.18)", "$type": "shadow" }
    }
  },
  "component": {
    "button": {
      "bg": { "$value": "{semantic.color.primary}", "$type": "color" },
      "fg": { "$value": "{semantic.color.on-primary}", "$type": "color" },
      "hover-bg": { "$value": "{semantic.color.primary-hover}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "{semantic.radius.sm}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.spacing.2}", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.spacing.4}", "$type": "dimension" }
    },
    "card": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "{semantic.radius.default}", "$type": "dimension" }
    },
    "input": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "focus-ring": { "$value": "{semantic.color.primary}", "$type": "color" },
      "radius": { "$value": "{semantic.radius.sm}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.spacing.2}", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.spacing.3}", "$type": "dimension" }
    },
    "sidebar-item": {
      "radius": { "$value": "{semantic.radius.sm}", "$type": "dimension" }
    }
  },
  "dark": {
    "semantic": {
      "color": {

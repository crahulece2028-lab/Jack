        "300": { "$value": "#FBBF24", "$type": "color" },
        "400": { "$value": "#F59E0B", "$type": "color" },
        "500": { "$value": "#D97706", "$type": "color" },
        "600": { "$value": "#B45309", "$type": "color" }
      },
      "stone": {
        "50": { "$value": "#F4F0E6", "$type": "color" },
        "100": { "$value": "#ECE6D8", "$type": "color" },
        "200": { "$value": "#E9E3D7", "$type": "color" },
        "300": { "$value": "#D7D0C0", "$type": "color" },
        "400": { "$value": "#98917F", "$type": "color" },
        "500": { "$value": "#6B6457", "$type": "color" },
        "900": { "$value": "#201D18", "$type": "color" }
      },
      "coal": {
        "600": { "$value": "#453E34", "$type": "color" },
        "700": { "$value": "#332E28", "$type": "color" },
        "800": { "$value": "#2A2621", "$type": "color" },
        "900": { "$value": "#221E1A", "$type": "color" },
        "950": { "$value": "#1A1714", "$type": "color" }

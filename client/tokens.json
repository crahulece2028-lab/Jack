        "muted": { "$value": "{primitive.color.ivory.300}", "$type": "color" },
        "placeholder": { "$value": "{primitive.color.ivory.500}", "$type": "color" },
        "border": { "$value": "{primitive.color.coal.700}", "$type": "color" },
        "border-strong": { "$value": "{primitive.color.coal.600}", "$type": "color" },
        "primary": { "$value": "{primitive.color.amber.400}", "$type": "color" },
        "primary-hover": { "$value": "{primitive.color.amber.300}", "$type": "color" },
        "primary-soft": { "$value": "rgba(245, 158, 11, 0.14)", "$type": "color" },
        "danger": { "$value": "{primitive.color.red.200}", "$type": "color" },
        "danger-soft": { "$value": "rgba(240, 161, 160, 0.12)", "$type": "color" },
        "danger-border": { "$value": "rgba(240, 161, 160, 0.35)", "$type": "color" }
      }
    }
